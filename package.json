{
  "name": "maengo",
  "private": true,
  "version": "0.0.1",
  "description": "맹고 — 매일 아침 나에게 맞는 기술 소식 5개를 읽고 듣는 웹앱",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "pnpm --filter @maengo/web dev",
    "build": "pnpm --filter @maengo/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "tsx --test 'packages/core/src/**/__tests__/*.test.ts' 'apps/web/lib/**/__tests__/*.test.ts' 'pipeline/src/**/__tests__/*.test.ts'",
    "setup:auth": "node --env-file=apps/web/.env.local scripts/supabase-auth.mjs",
    "apple:secret": "node --env-file=apps/web/.env.local scripts/apple-client-secret.mjs",
    "db:push": "supabase db push",
    "daily": "pnpm --filter @maengo/pipeline daily"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  }
}
