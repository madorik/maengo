# 맹고 환경 변수. 이 파일을 .env.local로 복사해 값을 채운다. 설명은 /API_KEYS.md

# AI — 지금은 더미로 돈다. 키가 들어오면 Gemini 클라이언트를 붙인다.
GEMINI_API_KEY=
GEMINI_MODEL_FREE=gemini-flash-latest
GEMINI_MODEL_PLUS=gemini-pro-latest
GEMINI_TTS_MODEL=

# 로그인 — 지금은 데모 로그인(버튼을 누르면 바로 들어감)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
