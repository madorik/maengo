# 맹고 환경 변수. 이 파일을 .env.local로 복사해 값을 채운다. 받는 곳은 /API_KEYS.md

# Supabase — 만들어 둠(.env.local에 이미 있음)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# AI — 요약·why는 파이프라인(pipeline/)이 Gemini로 만든다. 웹은 LLM을 부르지 않는다
GEMINI_API_KEY=
GEMINI_MODEL_FREE=gemini-flash-latest
GEMINI_MODEL_PLUS=gemini-pro-latest
GEMINI_MODEL_FALLBACK=gemini-flash-lite-latest
GEMINI_TTS_MODEL=gemini-3.8-flash-tts

# 파이프라인 — 개발 중 비용 절약(한 번 실행에 요약 3개, 영상 요약 없음). 비우면 40·2
PIPELINE_SUMMARIZE_LIMIT=3
PIPELINE_VIDEO_LIMIT=0

# 데모 로그인 — 애플 연동 전까지 애플 버튼이 이 Supabase 유저로 들어간다. 비우면 애플 버튼을 막는다(공개 배포)
DEMO_USER_ID=          # pnpm --filter @maengo/pipeline seed:demo 가 출력한다
SESSION_SECRET=        # openssl rand -base64 32
# 설정의 데모 도구(플랜 전환·피드 다시 고르기). 공개 배포에서는 비워 둔다
DEMO_TOOLS=1

# Cloudflare R2 — 듣기 음성 저장(비공개 버킷, 서명 URL로 재생). 키: R2 → API Tokens → Object Read & Write, 버킷 하나만
R2_ACCOUNT_ID=
R2_BUCKET=maengo-storage
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# local로 두면 R2 키가 있어도 로컬 디스크(.cache/audio-store)에 둔다(개발용)
AUDIO_STORE=

# 로그인 — pnpm setup:auth가 Supabase에 넣는다(앱 런타임에는 안 쓴다)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_SERVICES_ID=kr.maengo.web
APPLE_BUNDLE_ID=kr.maengo.app
APPLE_PRIVATE_KEY_PATH=

# 앱(Capacitor)
APP_URL_SCHEME=kr.maengo.app
ANDROID_PACKAGE=kr.maengo.app

# Firebase Cloud Messaging(앱·웹 푸시)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
FIREBASE_SERVICE_ACCOUNT_PATH=

# SEO — 정식 주소(공유 카드·사이트맵·canonical). 빌드 때 읽으니 바꾸면 다시 빌드한다
NEXT_PUBLIC_SITE_URL=https://maengo.kr
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=
