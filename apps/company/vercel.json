{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/try",
      "destination": "/maengo/try",
      "permanent": true
    },
    {
      "source": "/s/:token",
      "destination": "/maengo/s/:token",
      "permanent": true
    },
    {
      "source": "/topics",
      "destination": "/maengo/topics",
      "permanent": true
    },
    {
      "source": "/topics/:path*",
      "destination": "/maengo/topics/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/maengo",
      "destination": "https://maengo.vercel.app/maengo"
    },
    {
      "source": "/maengo/:path*",
      "destination": "https://maengo.vercel.app/maengo/:path*"
    }
  ]
}
