{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/maengo",
      "destination": "https://maengo.vercel.app/maengo"
    },
    {
      "source": "/maengo/:path*",
      "destination": "https://maengo.vercel.app/maengo/:path*"
    }
  ]
}
